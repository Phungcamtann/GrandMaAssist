digraph classPayment {graph [fontname="Arial", bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.65", splines=polyline]; node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", fillcolor="#f2f8f4", color="#8caf9a", margin="0.15,0.12"]; edge [fontname="Arial", fontsize=10, color="#668071", arrowsize=0.7];rankdir=TB;Application [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="92" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>Application</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id · status</TD></TR></TABLE>>];
WorkSession [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="157" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>WorkSession</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id · agreementVersion<BR ALIGN="LEFT"/>status: SessionStatus</TD></TR><TR><TD ALIGN="LEFT">isAgreementConfirmed()<BR ALIGN="LEFT"/>canStart()</TD></TR></TABLE>>];
AgreementSnapshot [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="171" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>AgreementSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">laborAmount · serviceFee<BR ALIGN="LEFT"/>totalDue · feePolicyVersion</TD></TR></TABLE>>];
PaymentRecord [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="219" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>PaymentRecord</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">status · totalFunded<BR ALIGN="LEFT"/>heldAmount · workerPaid<BR ALIGN="LEFT"/>feeRecognized · employerRefunded</TD></TR><TR><TD ALIGN="LEFT">isBalanced()</TD></TR></TABLE>>];
PaymentEvent [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="149" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>PaymentEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">operationId · type<BR ALIGN="LEFT"/>fundingDelta · feeDelta</TD></TR></TABLE>>];
FeePolicy [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="117" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>FeePolicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">version · rateBps</TD></TR><TR><TD ALIGN="LEFT">feeFor(amount)</TD></TR></TABLE>>];
Dispute [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="123" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>Dispute</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">status · openedBy<BR ALIGN="LEFT"/>reason</TD></TR></TABLE>>];
DisputeDecision [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="202" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>DisputeDecision</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">approvedLaborAmount<BR ALIGN="LEFT"/>computedFee · computedRefund<BR ALIGN="LEFT"/>decidedBy · reason</TD></TR></TABLE>>];
Application->WorkSession[dir=none,taillabel="1",headlabel="0..*",label="sinh ca",labeldistance=1.4];
WorkSession->AgreementSnapshot[dir=both,arrowtail=diamond,arrowhead=none,taillabel="1",headlabel="1",label="",labeldistance=1.4];
WorkSession->PaymentRecord[dir=none,taillabel="1",headlabel="1",label="",labeldistance=1.4];
PaymentRecord->PaymentEvent[dir=none,taillabel="1",headlabel="0..*",label="",labeldistance=1.4];
FeePolicy->AgreementSnapshot[dir=none,taillabel="1",headlabel="0..*",label="áp dụng",labeldistance=1.4];
WorkSession->Dispute[dir=none,taillabel="1",headlabel="0..*",label="",labeldistance=1.4];
Dispute->DisputeDecision[dir=both,arrowtail=diamond,arrowhead=none,taillabel="1",headlabel="0..1",label="",labeldistance=1.4];
}