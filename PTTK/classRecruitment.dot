digraph classRecruitment {graph [fontname="Arial", bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.65", splines=polyline]; node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", fillcolor="#f2f8f4", color="#8caf9a", margin="0.15,0.12"]; edge [fontname="Arial", fontsize=10, color="#668071", arrowsize=0.7];rankdir=TB;User [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="178" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id: String<BR ALIGN="LEFT"/>role: UserRole<BR ALIGN="LEFT"/>identityStatus: IdentityStatus</TD></TR><TR><TD ALIGN="LEFT">canConfirmSession()</TD></TR></TABLE>>];
JobSeekerProfile [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="171" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>JobSeekerProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">userId: String<BR ALIGN="LEFT"/>skills: List</TD></TR><TR><TD ALIGN="LEFT">isCompleteForApplication()</TD></TR></TABLE>>];
EmployerProfile [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="185" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>EmployerProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">userId: String<BR ALIGN="LEFT"/>employerType: EmployerType</TD></TR></TABLE>>];
JobPost [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="178" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>JobPost</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id: String<BR ALIGN="LEFT"/>status: JobStatus<BR ALIGN="LEFT"/>payAmount: Long</TD></TR><TR><TD ALIGN="LEFT">canReceiveApplication(now)</TD></TR></TABLE>>];
Application [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="157" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>Application</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id: String<BR ALIGN="LEFT"/>status: ApplicationStatus</TD></TR><TR><TD ALIGN="LEFT">canWithdraw()</TD></TR></TABLE>>];
SearchPreference [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="205" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>SearchPreference</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">categoryIds · areaCodes<BR ALIGN="LEFT"/>availableDays · avoidedDemands</TD></TR></TABLE>>];
IdentityVerificationRequest [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="181" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>IdentityVerificationRequest</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">userId · status · mode<BR ALIGN="LEFT"/>profileVersion · reviewedBy</TD></TR></TABLE>>];
JobCategory [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="100" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>JobCategory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">id · name</TD></TR></TABLE>>];
Area [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="167" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>Area</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">code · name · parentCode</TD></TR></TABLE>>];
SavedJob [shape=plain,margin=0,label=<<TABLE BORDER="0" WIDTH="163" CELLPADDING="6" CELLBORDER="1" CELLSPACING="0" COLOR="#8caf9a"><TR><TD BGCOLOR="#185b3e"><FONT COLOR="white"><B>SavedJob</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f7fbf8">seekerId · jobId · savedAt</TD></TR></TABLE>>];
