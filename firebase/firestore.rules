rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function seekerPath(uid) { return /databases/$(database)/documents/jobSeekerProfiles/$(uid); }
    function employerPath(uid) { return /databases/$(database)/documents/employerProfiles/$(uid); }
    function adminPath(uid) { return /databases/$(database)/documents/adminAccess/$(uid); }
    function clientRole(role) { return role in ['SEEKER', 'EMPLOYER']; }
    function admin() {
      return request.auth != null
        && get(adminPath(request.auth.uid)).data.enabled == true
        && get(userPath(request.auth.uid)).data.role == 'ADMIN'
        && get(userPath(request.auth.uid)).data.accountStatus == 'ACTIVE';
    }
    function noAdmin(uid) {
      return !exists(adminPath(uid)) || get(adminPath(uid)).data.get('enabled', false) != true;
    }
    function authPhone() { return request.auth.token.get('phone_number', ''); }
    function contact(d) {
      return d.phoneE164 is string && d.phoneE164 == authPhone()
        && ((d.phoneE164 == '' && d.phoneVerificationMode == 'NONE' && d.phoneVerifiedAt == null)
          || (d.phoneE164 != '' && d.phoneVerificationMode == 'FIREBASE_AUTH'
            && d.phoneVerifiedAt is timestamp && d.phoneVerifiedAt <= request.time));
    }
    function userShape(d, uid) {
      return d.keys().hasAll(['id', 'role', 'accountStatus', 'displayName', 'phoneE164',
          'phoneVerificationMode', 'phoneVerifiedAt', 'version', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'role', 'accountStatus', 'displayName', 'phoneE164',
          'phoneVerificationMode', 'phoneVerifiedAt', 'version', 'createdAt', 'updatedAt',
          'retirementStatus', 'identityStatus', 'currentRetirementRequestId', 'identityRequestId',
          'approvedIdentityProfileVersion'])
        && d.id == uid && clientRole(d.role)
        && d.displayName is string && d.displayName.size() <= 100
        && d.version is int && d.version >= 1
        && d.createdAt is timestamp && d.updatedAt == request.time
        && ((d.role == 'SEEKER' && d.keys().hasAll(['retirementStatus'])
            && !('identityStatus' in d) && !('identityRequestId' in d)
            && d.retirementStatus in ['NOT_SUBMITTED', 'SUBMITTED', 'APPROVED', 'NEEDS_INFO', 'REJECTED', 'REVERIFY_REQUIRED'])
          || (d.role == 'EMPLOYER' && d.keys().hasAll(['identityStatus'])
            && !('retirementStatus' in d) && !('currentRetirementRequestId' in d)
            && d.identityStatus in ['NOT_SUBMITTED', 'SUBMITTED', 'VERIFIED', 'NEEDS_INFO', 'REJECTED', 'REVERIFY_REQUIRED']));
    }
    function validArea(code) {
      return code is string && code.size() <= 80
        && (code == '' || (exists(/databases/$(database)/documents/areas/$(code))
          && get(/databases/$(database)/documents/areas/$(code)).data.active == true));
    }
    function skillAt(items, index) {
      return items.size() <= index || (items[index] is string
        && items[index].size() > 0 && items[index].size() <= 60);
    }
    function skills(items) {
      return items is list && items.size() <= 8
        && items.toSet().size() == items.size()
        && skillAt(items, 0) && skillAt(items, 1) && skillAt(items, 2) && skillAt(items, 3)
        && skillAt(items, 4) && skillAt(items, 5) && skillAt(items, 6) && skillAt(items, 7);
    }
    function commonProfile(d, uid) {
      return d.userId == uid && validArea(d.areaCode)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function seeker(d, uid) {
      return d.keys().hasAll(['userId', 'areaCode', 'skills', 'experienceSummary',
          'preferredShifts', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'areaCode', 'skills', 'experienceSummary',
          'preferredShifts', 'createdAt', 'updatedAt', 'fullName', 'dateOfBirth', 'identityProfileVersion'])
        && commonProfile(d, uid) && skills(d.skills)
        && d.experienceSummary is string && d.experienceSummary.size() <= 1000
        && d.preferredShifts is list && d.preferredShifts.size() <= 3
        && d.preferredShifts.hasOnly(['MORNING', 'AFTERNOON', 'EVENING'])
        && d.preferredShifts.toSet().size() == d.preferredShifts.size();
    }
    function employer(d, uid) {
      return d.keys().hasAll(['userId', 'areaCode', 'employerType', 'organizationName',
          'introduction', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'areaCode', 'employerType', 'organizationName',
          'introduction', 'createdAt', 'updatedAt', 'fullName', 'dateOfBirth', 'identityProfileVersion'])
        && commonProfile(d, uid) && d.employerType in ['INDIVIDUAL', 'ORGANIZATION']
        && d.organizationName is string && d.organizationName.size() <= 150
        && (d.employerType != 'ORGANIZATION' || d.organizationName.size() > 0)
        && (d.employerType != 'INDIVIDUAL' || d.organizationName == '')
        && d.introduction is string && d.introduction.size() <= 1000;
    }
    function profileOwnerAfter(uid, role) {
      let after = getAfter(userPath(uid)).data;
      return owner(uid) && noAdmin(uid) && after.id == uid && after.role == role
        && after.accountStatus == 'ACTIVE' && after.updatedAt == request.time;
    }
    function profileUpdate(uid, role) {
      let before = get(userPath(uid)).data;
      let after = getAfter(userPath(uid)).data;
      return profileOwnerAfter(uid, role) && before.role == role && before.accountStatus == 'ACTIVE'
        && after.version == before.version + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // C05: immutable requests; paired user/profile/request and decision/notification writes.
    function requestPath(role, id) {
      return role == 'SEEKER' ? /databases/$(database)/documents/retirementRequests/$(id)
        : /databases/$(database)/documents/identityRequests/$(id);
    }
    function profilePath(uid, role) { return role == 'SEEKER' ? seekerPath(uid) : employerPath(uid); }
    function pointer(role) { return role == 'SEEKER' ? 'currentRetirementRequestId' : 'identityRequestId'; }
    function statusField(role) { return role == 'SEEKER' ? 'retirementStatus' : 'identityStatus'; }
    function legal(d) {
      return d.keys().hasAll(['fullName', 'dateOfBirth', 'identityProfileVersion'])
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.dateOfBirth is string && d.dateOfBirth.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.identityProfileVersion is int && d.identityProfileVersion > 0;
    }
    function professional(d, role) {
      return d.areaCode != '' && validArea(d.areaCode)
        && (role == 'SEEKER' ? (d.skills.size() > 0 && d.experienceSummary.size() > 0 && d.preferredShifts.size() > 0)
          : (d.introduction.size() > 0));
    }
    function requestShape(d, id, role) {
      return d.keys().hasAll(['id', 'userId', 'role', 'status', 'previousRequestId', 'identityProfileVersion',
          'baseUserVersion', 'identitySnapshot', 'professionalSnapshot', 'evidenceType', 'imagePaths', 'lookupMode', 'lookupResult',
          'reason', 'reviewedBy', 'reviewedAt', 'decisionVersion', 'createdAt', 'updatedAt', 'consentedAt', 'submittedAt'])
        && d.keys().hasOnly(['id', 'userId', 'role', 'status', 'previousRequestId', 'identityProfileVersion',
          'baseUserVersion', 'identitySnapshot', 'professionalSnapshot', 'evidenceType', 'imagePaths', 'lookupMode', 'lookupResult',
          'reason', 'reviewedBy', 'reviewedAt', 'decisionVersion', 'createdAt', 'updatedAt', 'consentedAt', 'submittedAt'])
        && d.id == id && id.matches('[A-Za-z0-9-]{36}') && d.role == role
        && d.userId is string && d.previousRequestId is string
        && d.baseUserVersion is int && d.baseUserVersion >= 1
        && d.identityProfileVersion is int && d.identityProfileVersion >= 1
        && d.identitySnapshot is map
        && d.identitySnapshot.keys().hasAll(['fullName', 'dateOfBirth', 'documentNumber', 'source', 'parserVersion'])
        && d.identitySnapshot.keys().hasOnly(['fullName', 'dateOfBirth', 'documentNumber', 'source', 'parserVersion'])
        && d.identitySnapshot.fullName is string && d.identitySnapshot.fullName.size() > 0 && d.identitySnapshot.fullName.size() <= 100
        && d.identitySnapshot.dateOfBirth.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.identitySnapshot.documentNumber.matches('[0-9]{12}')
        && d.identitySnapshot.source == 'CCCD_QR' && d.identitySnapshot.parserVersion in [1, 2]
        && d.lookupMode == 'SIMULATED' && d.createdAt is timestamp && d.consentedAt is timestamp
        && d.updatedAt == request.time
        && d.imagePaths is list && d.imagePaths.size() >= (role == 'SEEKER' ? 2 : 1)
        && d.imagePaths.size() <= (role == 'SEEKER' ? 4 : 1)
        && d.imagePaths[0] == 'verification/' + d.userId + '/' + id + '/identity.jpg'
        && (d.imagePaths.size() < 2 || d.imagePaths[1] == 'verification/' + d.userId + '/' + id + '/evidence1.jpg')
        && (d.imagePaths.size() < 3 || d.imagePaths[2] == 'verification/' + d.userId + '/' + id + '/evidence2.jpg')
        && (d.imagePaths.size() < 4 || d.imagePaths[3] == 'verification/' + d.userId + '/' + id + '/evidence3.jpg')
        && (role == 'SEEKER' ? d.evidenceType in ['RETIREMENT_CERTIFICATE', 'BHXH_SIMULATED'] : d.evidenceType == 'IDENTITY_SAMPLE');
    }
    function stageCreate(d, id, role) {
      let u = get(userPath(d.userId)).data;
      let p = get(profilePath(d.userId, role)).data;
      return owner(d.userId) && noAdmin(d.userId) && u.role == role && u.accountStatus == 'ACTIVE'
        && u[statusField(role)] != 'SUBMITTED' && requestShape(d, id, role)
        && d.status == 'STAGING' && d.baseUserVersion == u.version
        && d.previousRequestId == u.get(pointer(role), '')
        && d.professionalSnapshot == profession(u, p, role)
        && d.identityProfileVersion == p.get('identityProfileVersion', 0) + 1
        && d.createdAt == request.time && d.consentedAt == request.time
        && d.submittedAt == null && d.reviewedAt == null && d.reviewedBy == ''
        && d.lookupResult == '' && d.reason == '' && d.decisionVersion == 0;
    }
    function profession(u, p, role) {
      return role == 'SEEKER'
        ? {'displayName': u.displayName, 'areaCode': p.areaCode, 'skills': p.skills,
            'experienceSummary': p.experienceSummary, 'preferredShifts': p.preferredShifts}
        : {'displayName': u.displayName, 'areaCode': p.areaCode, 'employerType': p.employerType,
            'organizationName': p.organizationName, 'introduction': p.introduction};
    }
    function submissionUser(uid, d) {
      let role = resource.data.role;
      let id = d[pointer(role)];
      let before = get(requestPath(role, id)).data;
      let r = getAfter(requestPath(role, id)).data;
      let p = getAfter(profilePath(uid, role)).data;
      return owner(uid) && noAdmin(uid) && resource.data.accountStatus == 'ACTIVE'
        && resource.data[statusField(role)] != 'SUBMITTED'
        && contact(d) && authPhone() != '' && userShape(d, uid)
        && d.diff(resource.data).affectedKeys().hasOnly([statusField(role), pointer(role), 'approvedIdentityProfileVersion', 'version', 'updatedAt'])
        && before.status == 'STAGING' && before.baseUserVersion == resource.data.version
        && r.status == 'SUBMITTED' && r.userId == uid && r.role == role && r.submittedAt == request.time
        && r.previousRequestId == resource.data.get(pointer(role), '')
        && d[statusField(role)] == 'SUBMITTED' && d.approvedIdentityProfileVersion == 0
        && d.version == resource.data.version + 1 && p.identityProfileVersion == r.identityProfileVersion
        && p.fullName == r.identitySnapshot.fullName && p.dateOfBirth == r.identitySnapshot.dateOfBirth;
    }
    function identityUpdate(uid, role) {
      let u = getAfter(userPath(uid)).data;
      let r = getAfter(requestPath(role, u[pointer(role)])).data;
      let d = request.resource.data;
      return profileUpdate(uid, role) && legal(d)
        && d.diff(resource.data).affectedKeys().hasOnly(['fullName', 'dateOfBirth', 'identityProfileVersion', 'updatedAt'])
        && r.userId == uid && r.status == 'SUBMITTED' && r.submittedAt == request.time
        && r.identityProfileVersion == resource.data.get('identityProfileVersion', 0) + 1
        && d.identityProfileVersion == r.identityProfileVersion
        && d.fullName == r.identitySnapshot.fullName && d.dateOfBirth == r.identitySnapshot.dateOfBirth;
    }
    function submitRequest(d, id, role) {
      let uid = resource.data.userId;
      let u = get(userPath(uid)).data;
      let after = getAfter(userPath(uid)).data;
      let p = get(profilePath(uid, role)).data;
      return owner(uid) && noAdmin(uid) && u.role == role && u.accountStatus == 'ACTIVE'
        && authPhone() != '' && u.phoneE164 == authPhone() && professional(p, role) && u.displayName.size() > 0
        && resource.data.status == 'STAGING' && d.status == 'SUBMITTED'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'updatedAt'])
        && d.submittedAt == request.time && d.updatedAt == request.time
        && d.baseUserVersion == u.version && u[statusField(role)] != 'SUBMITTED'
        && d.identityProfileVersion == p.get('identityProfileVersion', 0) + 1
        && after[pointer(role)] == id && after[statusField(role)] == 'SUBMITTED' && after.version == u.version + 1;
    }
    function terminal(status, role) {
      return status in ['NEEDS_INFO', 'REJECTED'] || status == (role == 'SEEKER' ? 'APPROVED' : 'VERIFIED');
    }
    function decisionRequest(d, id, role) {
      let uid = resource.data.userId;
      let u = get(userPath(uid)).data;
      let after = getAfter(userPath(uid)).data;
      let p = get(profilePath(uid, role)).data;
      let notice = getAfter(/databases/$(database)/documents/users/$(uid)/notifications/$(id + '_1')).data;
      return admin() && request.auth.uid != uid && resource.data.status == 'SUBMITTED'
        && resource.data.decisionVersion == 0 && d.decisionVersion == 1 && terminal(d.status, role)
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'lookupResult', 'reason', 'reviewedBy', 'reviewedAt', 'decisionVersion', 'updatedAt'])
        && d.lookupResult in ['MATCH', 'NOT_MATCH', 'INSUFFICIENT']
        && (!(d.status in ['APPROVED', 'VERIFIED']) || d.lookupResult == 'MATCH')
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 1000 && !d.reason.matches('(?s).*[0-9]{12}.*')
        && d.reviewedBy == request.auth.uid && d.reviewedAt == request.time && d.updatedAt == request.time
        && u.accountStatus == 'ACTIVE' && u[pointer(role)] == id && u[statusField(role)] == 'SUBMITTED'
        && p.identityProfileVersion == d.identityProfileVersion
        && after[statusField(role)] == d.status && after.version == u.version + 1
        && notice.requestId == id && notice.status == d.status && notice.reason == d.reason && notice.createdAt == request.time;
    }
    function userDecision(uid, d) {
      let role = resource.data.role;
      let id = resource.data[pointer(role)];
      let before = get(requestPath(role, id)).data;
      let r = getAfter(requestPath(role, id)).data;
      let p = get(profilePath(uid, role)).data;
      return admin() && request.auth.uid != uid && resource.data.accountStatus == 'ACTIVE'
        && d.diff(resource.data).affectedKeys().hasOnly([statusField(role), 'approvedIdentityProfileVersion', 'version', 'updatedAt'])
        && before.status == 'SUBMITTED' && resource.data[statusField(role)] == 'SUBMITTED'
        && r.userId == uid && r.reviewedBy == request.auth.uid && r.reviewedAt == request.time
        && r.decisionVersion == 1 && terminal(r.status, role)
        && d[statusField(role)] == r.status && d.updatedAt == request.time && d.version == resource.data.version + 1
        && r.identityProfileVersion == p.identityProfileVersion
        && d.approvedIdentityProfileVersion == (r.status in ['APPROVED', 'VERIFIED'] ? r.identityProfileVersion : 0);
    }
    function revocationPath(id) { return /databases/$(database)/documents/verificationRevocations/$(id); }
    function userRevocation(uid, d) {
      let role = resource.data.role;
      let id = resource.data[pointer(role)];
      let r = get(requestPath(role, id)).data;
      let rev = getAfter(revocationPath(id)).data;
      return admin() && request.auth.uid != uid && resource.data.accountStatus == 'ACTIVE'
        && resource.data[statusField(role)] in ['APPROVED', 'VERIFIED'] && r.status == resource.data[statusField(role)]
        && !exists(revocationPath(id)) && rev.userId == uid && rev.role == role
        && rev.reviewedBy == request.auth.uid && rev.createdAt == request.time
        && d.diff(resource.data).affectedKeys().hasOnly([statusField(role), 'approvedIdentityProfileVersion', 'version', 'updatedAt'])
        && d[statusField(role)] == 'REVERIFY_REQUIRED' && d.approvedIdentityProfileVersion == 0
        && d.version == resource.data.version + 1 && d.updatedAt == request.time;
    }
    match /verificationRevocations/{id} {
      allow get: if (request.auth != null && !exists(revocationPath(id))) || owner(resource.data.userId) || admin();
      allow list, update, delete: if false;
      allow create: if revocation(id, request.resource.data);
    }
    function revocation(id, d) {
      let u = get(userPath(d.userId)).data;
      let after = getAfter(userPath(d.userId)).data;
      let r = get(requestPath(d.role, id)).data;
      let p = get(profilePath(d.userId, d.role)).data;
      let n = getAfter(/databases/$(database)/documents/users/$(d.userId)/notifications/$(id + '_2')).data;
      return admin() && request.auth.uid != d.userId
        && d.keys().hasAll(['requestId', 'userId', 'role', 'identityProfileVersion', 'reason', 'reviewedBy', 'createdAt'])
        && d.keys().hasOnly(['requestId', 'userId', 'role', 'identityProfileVersion', 'reason', 'reviewedBy', 'createdAt'])
        && d.requestId == id && d.role == u.role && u[pointer(d.role)] == id
        && u[statusField(d.role)] in ['APPROVED', 'VERIFIED'] && r.status == u[statusField(d.role)]
        && p.identityProfileVersion == r.identityProfileVersion && d.identityProfileVersion == p.identityProfileVersion
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 1000 && !d.reason.matches('(?s).*[0-9]{12}.*')
        && d.reviewedBy == request.auth.uid && d.createdAt == request.time
        && after[statusField(d.role)] == 'REVERIFY_REQUIRED' && after.approvedIdentityProfileVersion == 0
        && after.version == u.version + 1 && n.status == 'REVERIFY_REQUIRED' && n.reason == d.reason && n.createdAt == request.time;
    }
    match /retirementRequests/{id} {
      allow get: if (request.auth != null && !exists(requestPath('SEEKER', id))) || owner(resource.data.userId) || admin();
      allow list: if admin() && request.query.limit <= 50 && resource.data.status == 'SUBMITTED';
      allow create: if stageCreate(request.resource.data, id, 'SEEKER');
      allow update: if submitRequest(request.resource.data, id, 'SEEKER') || decisionRequest(request.resource.data, id, 'SEEKER');
      allow delete: if false;
    }
    match /identityRequests/{id} {
      allow get: if (request.auth != null && !exists(requestPath('EMPLOYER', id))) || owner(resource.data.userId) || admin();
      allow list: if admin() && request.query.limit <= 50 && resource.data.status == 'SUBMITTED';
      allow create: if stageCreate(request.resource.data, id, 'EMPLOYER');
      allow update: if submitRequest(request.resource.data, id, 'EMPLOYER') || decisionRequest(request.resource.data, id, 'EMPLOYER');
      allow delete: if false;
    }
    match /users/{uid}/notifications/{noticeId} {
      allow read: if owner(uid);
      allow create: if admin() && request.auth.uid != uid
        && (notice(uid, noticeId, request.resource.data) || revokeNotice(uid, noticeId, request.resource.data));
      allow update, delete: if false;
    }
    function notice(uid, noticeId, d) {
      let u = get(userPath(uid)).data;
      let r = getAfter(requestPath(u.role, d.requestId)).data;
      return d.keys().hasAll(['requestId', 'decisionVersion', 'status', 'reason', 'createdAt'])
        && d.keys().hasOnly(['requestId', 'decisionVersion', 'status', 'reason', 'createdAt'])
        && noticeId == d.requestId + '_1' && d.decisionVersion == 1
        && get(requestPath(u.role, d.requestId)).data.status == 'SUBMITTED'
        && r.userId == uid && r.reviewedBy == request.auth.uid && r.reviewedAt == request.time
        && r.decisionVersion == 1 && d.status == r.status && d.reason == r.reason && d.createdAt == request.time;
    }
    function revokeNotice(uid, noticeId, d) {
      let rev = getAfter(revocationPath(d.requestId)).data;
      return d.keys().hasAll(['requestId', 'decisionVersion', 'status', 'reason', 'createdAt'])
        && d.keys().hasOnly(['requestId', 'decisionVersion', 'status', 'reason', 'createdAt'])
        && noticeId == d.requestId + '_2' && d.decisionVersion == 2 && d.status == 'REVERIFY_REQUIRED'
        && !exists(revocationPath(d.requestId)) && rev.userId == uid
        && rev.reviewedBy == request.auth.uid && rev.createdAt == request.time
        && d.reason == rev.reason && d.createdAt == request.time;
    }
    match /appConfig/public { allow get: if true; allow list, write: if false; }
    match /areas/{code} {
      allow get, list: if request.auth != null && resource.data.active == true;
      allow write: if false;
    }
    match /jobCategories/{id} {
      allow get: if request.auth != null && resource.data.active == true;
      allow list: if request.auth != null && resource.data.active == true && request.query.limit <= 100;
      allow write: if false;
    }
    match /adminAccess/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list, delete: if false;
      allow create: if owner(uid) && noAdmin(uid) && userShape(request.resource.data, uid)
        && request.resource.data.accountStatus == 'ACTIVE'
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time
        && !('currentRetirementRequestId' in request.resource.data) && !('identityRequestId' in request.resource.data)
        && !('approvedIdentityProfileVersion' in request.resource.data)
        && request.resource.data[statusField(request.resource.data.role)] == 'NOT_SUBMITTED'
        && contact(request.resource.data)
        && (request.resource.data.phoneE164 == '' || request.resource.data.phoneVerifiedAt == request.time)
        && ((request.resource.data.role == 'SEEKER' && !exists(employerPath(uid))
              && getAfter(seekerPath(uid)).data.userId == uid)
          || (request.resource.data.role == 'EMPLOYER' && !exists(seekerPath(uid))
              && getAfter(employerPath(uid)).data.userId == uid));
      allow update: if (owner(uid) && noAdmin(uid) && resource.data.accountStatus == 'ACTIVE'
        && userShape(request.resource.data, uid) && contact(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneE164', 'phoneVerificationMode', 'phoneVerifiedAt', 'updatedAt', 'version'])
        && request.resource.data.version == resource.data.version + 1
        && (request.resource.data.phoneE164 == resource.data.phoneE164
          ? request.resource.data.phoneVerifiedAt == resource.data.phoneVerifiedAt
          : (request.resource.data.phoneE164 == '' || request.resource.data.phoneVerifiedAt == request.time)))
        || submissionUser(uid, request.resource.data) || userDecision(uid, request.resource.data)
        || userRevocation(uid, request.resource.data);
    }
    match /jobSeekerProfiles/{uid} {
      allow get: if owner(uid) || admin();
      allow list, delete: if false;
      allow create: if profileOwnerAfter(uid, 'SEEKER') && !exists(userPath(uid))
        && !exists(employerPath(uid)) && seeker(request.resource.data, uid)
        && !('identityProfileVersion' in request.resource.data) && !('fullName' in request.resource.data) && !('dateOfBirth' in request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if seeker(request.resource.data, uid) &&
        ((profileUpdate(uid, 'SEEKER') && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'areaCode', 'skills', 'experienceSummary', 'preferredShifts', 'updatedAt'])) || identityUpdate(uid, 'SEEKER'));
    }
    match /employerProfiles/{uid} {
      allow get: if owner(uid) || admin();
      allow list, delete: if false;
      allow create: if profileOwnerAfter(uid, 'EMPLOYER') && !exists(userPath(uid))
        && !exists(seekerPath(uid)) && employer(request.resource.data, uid)
        && !('identityProfileVersion' in request.resource.data) && !('fullName' in request.resource.data) && !('dateOfBirth' in request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if employer(request.resource.data, uid) &&
        ((profileUpdate(uid, 'EMPLOYER') && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'areaCode', 'employerType', 'organizationName', 'introduction', 'updatedAt'])) || identityUpdate(uid, 'EMPLOYER'));
    }
    // C07: public workAddress belongs to a moderated post, never the identity profile.
    function jobPath(id) { return /databases/$(database)/documents/jobs/$(id); }
    function jobHistoryPath(id, v) { return /databases/$(database)/documents/jobs/$(id)/history/$(string(v)); }
    // C07 Rules revision 2026-10-26 r4: expression-limit fix, verified on local emulator.
    function jobArea(code) {
      return code is string && code.size() > 0 && code.size() <= 80
        && get(/databases/$(database)/documents/areas/$(code)).data.active == true;
    }
    function jobAccount(uid, u) {
      return owner(uid) && noAdmin(uid) && u.role == 'EMPLOYER' && u.accountStatus == 'ACTIVE';
    }
    function jobPhone(u) {
      return authPhone() != '' && u.phoneE164 == authPhone() && u.phoneVerificationMode == 'FIREBASE_AUTH'
        && u.phoneVerifiedAt is timestamp && u.phoneVerifiedAt <= request.time;
    }
    function jobProfile(uid, u, p) {
      return jobText(u.displayName,100,true) && p.userId == uid && jobArea(p.areaCode)
        && jobText(p.introduction,1000,true)
        && p.employerType in ['INDIVIDUAL', 'ORGANIZATION']
        && (p.employerType != 'ORGANIZATION' || jobText(p.organizationName,150,true));
    }
    function jobEmployer(uid, u, p) {
      return jobAccount(uid,u) && jobPhone(u) && jobProfile(uid,u,p);
    }
    function jobCatalog(d) {
      let category = get(/databases/$(database)/documents/jobCategories/$(d.categoryId)).data;
      let area = get(/databases/$(database)/documents/areas/$(d.areaCode)).data;
      return d.categoryId.size() > 0 && d.areaCode.size() > 0
        && category.active == true && area.active == true
        && d.categoryName == category.name && d.areaName == area.name;
    }
    function jobText(v, maximum, required) {
      return v is string && v.size() <= maximum && (!required || v.matches('(?s).*[^\\s].*'));
    }
    function jobSkills(items) {
      return items is list && items.size() <= 8 && items.toSet().size() == items.size()
        && (items.size() <= 0 || items[0].matches('(?s).{1,60}'))
        && (items.size() <= 1 || items[1].matches('(?s).{1,60}'))
        && (items.size() <= 2 || items[2].matches('(?s).{1,60}'))
        && (items.size() <= 3 || items[3].matches('(?s).{1,60}'))
        && (items.size() <= 4 || items[4].matches('(?s).{1,60}'))
        && (items.size() <= 5 || items[5].matches('(?s).{1,60}'))
        && (items.size() <= 6 || items[6].matches('(?s).{1,60}'))
        && (items.size() <= 7 || items[7].matches('(?s).{1,60}'));
    }
    function jobShape(d, id) {
      let keys = d.keys();
      return keys.size() == 28 && keys.hasOnly(['id','employerId','employerDisplayName','title','categoryId','categoryName','areaCode','areaName',
          'workAddress','description','requirementsText','requiredSkillTags','workDays','workShift','scheduleText',
          'physicalDemands','demandsDeclared','payAmount','payUnit','expiresAt','status','version','lastSubmissionId',
          'createdAt','updatedAt','reviewedBy','reviewedAt','reviewReason'])
        && d.id == id && id.matches('[A-Za-z0-9-]{36}')
        && d.employerId.size() <= 128 && d.employerId.matches('(?s).*[^\\s].*') && d.employerDisplayName.size() <= 150 && d.employerDisplayName.matches('(?s).*[^\\s].*')
        && d.title.size() <= 120 && d.title.matches('(?s).*[^\\s].*') && d.categoryId.size() <= 80 && d.categoryId.matches('(?s).*[^\\s].*') && d.categoryName.size() <= 120 && d.categoryName.matches('(?s).*[^\\s].*')
        && d.areaCode.size() <= 80 && d.areaCode.matches('(?s).*[^\\s].*') && d.areaName.size() <= 120 && d.areaName.matches('(?s).*[^\\s].*')
        && d.workAddress.size() <= 500 && d.workAddress.matches('(?s).*[^\\s].*') && d.description.size() <= 3000 && d.description.matches('(?s).*[^\\s].*')
        && d.requirementsText.matches('(?s).{0,1000}') && jobSkills(d.requiredSkillTags)
        && d.workDays is list && d.workDays.size() > 0 && d.workDays.size() <= 7
        && d.workDays.hasOnly(['MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY','SUNDAY'])
        && d.workDays.toSet().size() == d.workDays.size()
        && d.workShift in ['MORNING','AFTERNOON','EVENING','FLEXIBLE'] && d.scheduleText.size() <= 500 && d.scheduleText.matches('(?s).*[^\\s].*')
        && d.physicalDemands is list && d.physicalDemands.size() <= 3
        && d.physicalDemands.hasOnly(['HEAVY_LIFTING','PROLONGED_STANDING','FREQUENT_MOVEMENT'])
        && d.physicalDemands.toSet().size() == d.physicalDemands.size() && d.demandsDeclared == true
        && d.payAmount is int && d.payAmount > 0 && d.payUnit in ['HOUR','SESSION','DAY']
        && d.expiresAt is timestamp && d.version is int && d.version >= 1
        && d.status in ['PENDING_REVIEW','OPEN','REJECTED']
        && d.lastSubmissionId.size() <= 80 && d.lastSubmissionId.matches('(?s).*[^\\s].*') && d.createdAt is timestamp && d.updatedAt == request.time
        && d.reviewedBy is string && d.reviewReason.matches('(?s).{0,1000}');
    }
    function submittedJob(d) {
      let u = get(userPath(d.employerId)).data;
      let p = get(employerPath(d.employerId)).data;
      return jobEmployer(d.employerId, u, p) && jobCatalog(d) && d.expiresAt > request.time
        && d.employerDisplayName == (p.employerType == 'ORGANIZATION' ? p.organizationName : u.displayName)
        && d.status == 'PENDING_REVIEW' && d.lastSubmissionId == d.id + '_s' + string(d.version)
        && d.reviewedBy == '' && d.reviewedAt == null && d.reviewReason == '';
    }
    function jobEvent(d, action, before) {
      let e = getAfter(jobHistoryPath(d.id,d.version)).data;
      return e.jobId == d.id && e.version == d.version && e.actorId == request.auth.uid
        && e.action == action && e.createdAt == request.time && e.before == before && e.after == d;
    }
    function jobHistoryCreate(id, v, d) {
      let path = jobPath(id);
      let existed = exists(path);
      let before = existed ? get(path).data : null;
      let after = getAfter(path).data;
      return d.keys().hasAll(['jobId','version','actorId','action','createdAt','before','after'])
        && d.keys().hasOnly(['jobId','version','actorId','action','createdAt','before','after'])
        && d.jobId == id && v == string(d.version) && d.actorId == request.auth.uid
        && d.createdAt == request.time && d.after == after && d.version == after.version
        && (!existed
          ? (d.before == null && d.version == 1 && d.action == 'SUBMITTED'
              && after.employerId == request.auth.uid && after.status == 'PENDING_REVIEW')
          : (d.before == before && d.version == before.version + 1
              && ((before.status == 'REJECTED' && d.action == 'SUBMITTED'
                    && before.employerId == request.auth.uid && after.status == 'PENDING_REVIEW')
                || (admin() && before.employerId != request.auth.uid && before.status == 'PENDING_REVIEW'
                    && ((d.action == 'APPROVED' && after.status == 'OPEN')
                      || (d.action == 'REJECTED' && after.status == 'REJECTED'))))));
    }
    // Read-only owner diagnostics. These paths need no documents and can never be written.
    // They expose only predicates over data the owner can already read, never job content.
    function jobSourceCheck(uid, check) {
      let u = get(userPath(uid)).data;
      return (check == 'account' && jobAccount(uid,u))
        || (check == 'phone' && jobPhone(u))
        || (check == 'profile' && jobProfile(uid,u,get(employerPath(uid)).data));
    }
    match /jobSubmissionDiagnostics/{uid}/checks/{check} {
      allow get: if owner(uid) && (check == 'revision_20261026_3' || jobSourceCheck(uid,check));
      allow list, write: if false;
    }
    match /jobSubmissionDiagnostics/{uid}/expiry/{millis} {
      allow get: if owner(uid) && millis.matches('[0-9]{1,16}') && timestamp.value(int(millis)) > request.time;
      allow list, write: if false;
    }
    match /jobs/{id} {
      allow get: if (request.auth != null && !exists(jobPath(id)))
        || resource.data.status == 'OPEN' || (request.auth != null && resource.data.employerId == request.auth.uid) || admin();
      allow list: if request.query.limit <= 20 && (resource.data.status == 'OPEN'
        || (request.auth != null && resource.data.employerId == request.auth.uid) || admin());
      allow create: if request.auth != null && resource == null && jobShape(request.resource.data,id)
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time
        && submittedJob(request.resource.data) && jobEvent(request.resource.data,'SUBMITTED',null);
      allow update: if request.auth != null && resource != null && jobShape(request.resource.data,id)
        && request.resource.data.employerId == resource.data.employerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1
        && ((resource.data.status == 'REJECTED' && submittedJob(request.resource.data)
              && jobEvent(request.resource.data,'SUBMITTED',resource.data))
          || (admin() && resource.data.employerId != request.auth.uid && resource.data.status == 'PENDING_REVIEW'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','updatedAt','reviewedBy','reviewedAt','reviewReason'])
            && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
            && ((request.resource.data.status == 'OPEN' && request.resource.data.reviewReason == ''
                  && request.resource.data.expiresAt > request.time && jobCatalog(request.resource.data)
                  && jobEvent(request.resource.data,'APPROVED',resource.data))
              || (request.resource.data.status == 'REJECTED' && jobText(request.resource.data.reviewReason,1000,true)
                  && jobEvent(request.resource.data,'REJECTED',resource.data)))));
      allow delete: if false;
      match /history/{v} {
        allow get, list: if request.auth != null && (get(jobPath(id)).data.employerId == request.auth.uid || admin());
        allow create: if request.auth != null && jobHistoryCreate(id,v,request.resource.data);
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
