rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Two distinct Firestore documents maximum in each evaluation.
    function admin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/adminAccess/$(request.auth.uid)).data.enabled == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountStatus == 'ACTIVE';
    }
    function staging(uid, id, file) {
      let u = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      let r = u.role == 'SEEKER'
        ? firestore.get(/databases/(default)/documents/retirementRequests/$(id)).data
        : firestore.get(/databases/(default)/documents/identityRequests/$(id)).data;
      return u.accountStatus == 'ACTIVE' && r.userId == uid && r.status == 'STAGING'
        && ('verification/' + uid + '/' + id + '/' + file) in r.imagePaths;
    }
    match /verification/{uid}/{id}/{file} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid && staging(uid, id, file)
        && file.matches('(identity|evidence[1-3])[.]jpg')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Existing bytes are immutable, including before submission.
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
