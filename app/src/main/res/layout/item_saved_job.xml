<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clickable="true" android:focusable="true"
    android:screenReaderFocusable="true" android:saveEnabled="false"
    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp" app:strokeColor="@color/public_card_stroke" app:rippleColor="@color/button_ripple">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="16dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/sjItemTitle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GrandMa.PublicCardTitle"
                android:textColor="#1A1C19" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/sjItemBadge" style="@style/Widget.GrandMa.PublicBadge"
                android:layout_marginStart="8dp" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="4dp" android:paddingBottom="4dp"/>
        </LinearLayout>
        <TextView android:id="@+id/sjItemEmployer" style="@style/Widget.GrandMa.PublicCardBody"
            android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/sjItemCategory" style="@style/Widget.GrandMa.PublicCardBody"
            android:textColor="@color/brand_green"/>
        <TextView android:id="@+id/sjItemPay" style="@style/Widget.GrandMa.PublicCardBody"
            android:textAppearance="@style/TextAppearance.GrandMa.Label" android:textColor="#1C6758"/>
        <TextView android:id="@+id/sjItemSavedDate" style="@style/Widget.GrandMa.PublicCardBody"
            android:textColor="#747775" android:textSize="13sp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
            android:background="@color/public_card_border"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end|center_vertical">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sjItemBtnUnsave"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="44dp" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="6dp" android:paddingBottom="6dp"
                android:includeFontPadding="false" android:gravity="center"
                android:background="@drawable/button_secondary"
                android:text="@string/sj_unsave" android:textColor="@color/text_error"
                android:textSize="16sp" android:fontFamily="@font/be_vietnam_pro_semibold"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
