<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roleAccountContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/screen_padding"
    android:orientation="vertical"
    android:saveEnabled="false"
    android:visibility="gone">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/accountHubBack"
        style="@style/Widget.GrandMa.BackLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/n_back"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#1C6758"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="@string/n_account_title"
        android:accessibilityHeading="true"/>

    <!-- Single Unified Account Information Card -->
    <LinearLayout
        style="@style/Widget.GrandMa.HomeCard"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/accountHubName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1C6758"
            android:textSize="20sp"
            android:textStyle="bold"
            android:saveEnabled="false"/>

        <TextView
            android:id="@+id/accountHubRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold"
            android:saveEnabled="false"/>

        <TextView
            android:id="@+id/accountHubArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.GrandMa.Body"
            android:saveEnabled="false"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E4E1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C6758"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Phương thức đăng nhập:"/>

        <TextView
            android:id="@+id/accountHubAuthMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#2C3332"
            android:textSize="15sp"
            android:text="Google Account"/>
    </LinearLayout>

    <!-- Direct actions below card -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/accountHubWallet"
        style="@style/Widget.GrandMa.HomeButton"
        android:layout_marginTop="16dp"
        android:text="Ví tiền của tôi"
        android:drawableStart="@drawable/ic_wallet"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/accountHubSignOut"
        style="@style/Widget.GrandMa.HomeButton"
        android:layout_marginTop="12dp"
        android:text="@string/auth_sign_out"
        android:textColor="@color/text_error"/>

    <!-- Dummy stub views kept for ID reference compatibility without rendering -->
    <View android:id="@+id/accountHubProfile" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/accountHubSavedJobs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/accountHubVerification" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/accountHubSecurity" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/accountHubSettings" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/accountHubHelp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
