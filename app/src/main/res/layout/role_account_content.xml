<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roleAccountContent" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="@dimen/screen_padding" android:orientation="vertical" android:saveEnabled="false" android:visibility="gone">
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubBack" style="@style/Widget.GrandMa.BackLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/n_back"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/n_account_title"
        android:textAppearance="@style/TextAppearance.GrandMa.Title" android:accessibilityHeading="true"/>
    <LinearLayout style="@style/Widget.GrandMa.HomeCard">
        <TextView android:id="@+id/accountHubName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:saveEnabled="false"/>
        <TextView android:id="@+id/accountHubRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
        <TextView android:id="@+id/accountHubArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubProfile" style="@style/Widget.GrandMa.HomeButton" android:text="@string/n_profile_open"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubVerification" style="@style/Widget.GrandMa.HomeButton" android:text="@string/n_admin_review" android:visibility="gone"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubSecurity" style="@style/Widget.GrandMa.HomeButton" android:text="@string/n_security"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubSettings" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_settings"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubHelp" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_help"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/accountHubSignOut" style="@style/Widget.GrandMa.HomeButton" android:text="@string/auth_sign_out" android:textColor="@color/text_error"/>
</LinearLayout>
