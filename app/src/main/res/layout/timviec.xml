<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm việc"
            android:textColor="#242424"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtTenCongViec"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Nhập tên công việc"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnTimKiem"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginStart="9dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans"
                android:padding="0dp"
                android:text="Tìm kiếm"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Label Danh mục / Khu vực -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh mục"
                android:textColor="#292929"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Khu vực"
                android:textColor="#292929"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Spinner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spDanhMuc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:entries="@array/danh_muc_array"
                android:background="@drawable/bg_spinner"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

            <Spinner
                android:id="@+id/spKhuVuc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:entries="@array/khu_vuc_array"
                android:background="@drawable/bg_spinner"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- Buổi -->
        <RadioGroup
            android:id="@+id/rgBuoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBuoiSang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#486B84"
                android:checked="true"
                android:text="Buổi sáng"
                android:textColor="#424242"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbBuoiChieu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#486B84"
                android:text="Buổi chiều"
                android:textColor="#424242"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbCaNgay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#486B84"
                android:text="Cả ngày"
                android:textColor="#424242"
                android:textSize="13sp" />

        </RadioGroup>

        <!-- Số lượng -->
        <TextView
            android:id="@+id/tvSoViec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3 việc phù hợp"
            android:textColor="#292929"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- JOB 1 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_job_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chăm sóc người cao tuổi tại nhà"
                android:textColor="#292929"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Q. Bình Thạnh"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65.000đ/giờ"
                    android:textColor="#292929"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="7:00–11:00 · T2–T6"
                android:textColor="#666666"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbLuu1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#486B84"
                    android:checked="true"
                    android:text="Lưu"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnXem1"
                    android:layout_width="70dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_outline"
                    android:padding="0dp"
                    android:text="Xem"
                    android:textAllCaps="false"
                    android:textColor="#292929"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- JOB 2 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_job_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phụ bếp quán cơm gia đình"
                android:textColor="#292929"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Q. Phú Nhuận"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="320.000đ/ngày"
                    android:textColor="#292929"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="8:00–16:00 · T2–T7"
                android:textColor="#666666"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbLuu2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#486B84"
                    android:text="Lưu"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnXem2"
                    android:layout_width="70dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_outline"
                    android:padding="0dp"
                    android:text="Xem"
                    android:textAllCaps="false"
                    android:textColor="#292929"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- JOB 3 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_job_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trông trẻ buổi chiều"
                android:textColor="#292929"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TP. Thủ Đức"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4,5 triệu/tháng"
                    android:textColor="#292929"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="13:00–18:00 · T2–T6"
                android:textColor="#666666"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbLuu3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#486B84"
                    android:text="Lưu"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnXem3"
                    android:layout_width="70dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_outline"
                    android:padding="0dp"
                    android:text="Xem"
                    android:textAllCaps="false"
                    android:textColor="#292929"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>