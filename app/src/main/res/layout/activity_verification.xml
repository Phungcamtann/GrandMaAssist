<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verificationScreenRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface_ivory">
    <include layout="@layout/role_topbar"/>
    <LinearLayout android:id="@+id/vToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/vBack" style="@style/Widget.GrandMa.PublicToolbarButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp"
            android:background="@drawable/public_back_button" android:gravity="start|center_vertical"
            android:textSize="18sp" android:text="@string/n_back"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/vReload" style="@style/Widget.GrandMa.PublicToolbarButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:textSize="15sp" android:maxLines="1" android:singleLine="true"
            android:text="@string/p_reload" android:contentDescription="@string/p_reload"/>
    </LinearLayout>
    <ScrollView android:id="@+id/verificationScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:saveEnabled="false">
    <LinearLayout android:id="@+id/verificationRoot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:saveEnabled="false">
        
        <TextView android:id="@+id/vPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/v_title" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:accessibilityHeading="true"/>
        <LinearLayout android:id="@+id/vFeedbackSection" style="@style/Widget.GrandMa.VerificationSection" android:visibility="gone">
            <TextView android:id="@+id/vMessage" style="@style/Widget.GrandMa.VerificationMessage" android:layout_marginTop="0dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/vOwner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout style="@style/Widget.GrandMa.VerificationSection">
                <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_status_title"/>
                <TextView android:id="@+id/vCurrent" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/vViewCurrent" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_view_current"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/vDraft" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/vIdentitySection" style="@style/Widget.GrandMa.VerificationSection">
                    <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_identity_section"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vCapture" style="@style/Widget.GrandMa.VerificationPrimary" android:text="@string/v_capture"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vPickCard" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_pick_card"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vEditCard" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_edit_card" android:visibility="gone"/>
                    <TextView android:id="@+id/vIdentityMessage" style="@style/Widget.GrandMa.VerificationMessage"/>
                    <LinearLayout android:id="@+id/vCandidate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:padding="12dp" android:background="@color/surface_soft_green" android:orientation="vertical" android:visibility="gone">
                        <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_identity_preview"/>
                        <ImageView android:id="@+id/vCandidateImage" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="12dp"
                            android:scaleType="fitCenter" android:contentDescription="@string/v_preview" android:saveEnabled="false"/>
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/vUseImage" style="@style/Widget.GrandMa.VerificationPrimary" android:text="@string/v_use_image"/>
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/vDiscardImage" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_discard_image"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/vIdentityImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    <TextView android:id="@+id/vIdentity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/vEvidenceSection" style="@style/Widget.GrandMa.VerificationSection">
                    <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_evidence_section"/>
                    <RadioGroup android:id="@+id/vEvidenceType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false">
                        <RadioButton android:id="@+id/vRetirement" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_retirement"/>
                        <RadioButton android:id="@+id/vBhxh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_bhxh"/>
                    </RadioGroup>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vAddEvidence" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_add_evidence"/>
                    <TextView android:id="@+id/vEvidenceCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" android:accessibilityLiveRegion="polite" android:saveEnabled="false"/>
                    <TextView android:id="@+id/vEvidenceMessage" style="@style/Widget.GrandMa.VerificationMessage"/>
                    <LinearLayout android:id="@+id/vEvidenceImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/vSubmitSection" style="@style/Widget.GrandMa.VerificationSection">
                    <TextView android:id="@+id/vSubmitHeading" style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_submit_section"/>
                    <TextView android:id="@+id/vEmployerIdentityNote" style="@style/Widget.GrandMa.VerificationMessage" android:text="@string/v_employer_identity_note" android:visibility="gone"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vProcess" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_process"/>
                    <CheckBox android:id="@+id/vConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_consent"/>
                    <ProgressBar android:id="@+id/vSubmitProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="12dp" android:visibility="gone" android:importantForAccessibility="no"/>
                    <TextView android:id="@+id/vSubmitMessage" style="@style/Widget.GrandMa.VerificationMessage"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vSend" style="@style/Widget.GrandMa.VerificationPrimary" android:text="@string/v_send"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vCancelUpload" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_cancel_upload" android:visibility="gone"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vClear" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_clear"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/vNoticeSection" style="@style/Widget.GrandMa.VerificationSection" android:visibility="gone">
                <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_notices"/>
                <LinearLayout android:id="@+id/vNotices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/vAdmin" style="@style/Widget.GrandMa.VerificationSection" android:visibility="gone">
            <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_admin_section"/>
            
            <!-- Ô tìm kiếm và icon tìm kiếm cùng 1 hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/vSearch"
                    style="@style/Widget.GrandMa.ProfileInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:inputType="textNoSuggestions"
                    android:maxLength="128"
                    android:hint="@string/v_search_hint"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/vFind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary"
                    android:src="@drawable/ic_search"
                    android:tint="#1C6758"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/v_find" />
            </LinearLayout>

            <!-- Hàng bộ lọc: Chưa duyệt || Đã duyệt || Icon phễu -->
            <LinearLayout
                android:id="@+id/vFilterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/vFilterPending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:background="@drawable/button_primary"
                    android:textColor="@color/white"
                    android:text="Chưa duyệt" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/vFilterApproved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="44dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/brand_green"
                    android:text="Đã duyệt" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/vFilterRole"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary"
                    android:src="@drawable/ic_filter"
                    android:tint="#1C6758"
                    android:scaleType="centerInside"
                    android:contentDescription="Lọc vai trò" />
            </LinearLayout>

            <TextView
                android:id="@+id/vRoleFilterLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#5C6360"
                android:text="Đang lọc: Tất cả vai trò" />

            <LinearLayout
                android:id="@+id/vQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/vReview" style="@style/Widget.GrandMa.VerificationSection" android:visibility="gone">
            <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_review_section"/>
            <TextView android:id="@+id/vReviewIdentity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/vPrevious" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_previous"/>
            <LinearLayout android:id="@+id/vReviewImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/vRetryImages" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_retry_images"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/vUpdateIdentity" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_update_identity" android:visibility="gone"/>
            <LinearLayout android:id="@+id/vDecision" style="@style/Widget.GrandMa.VerificationSection" android:background="@color/surface_soft_green">
                <TextView style="@style/Widget.GrandMa.VerificationHeading" android:text="@string/v_decision_section"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/v_simulated" android:textAppearance="@style/TextAppearance.GrandMa.Body"/>
                <RadioGroup android:id="@+id/vLookup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false">
                    <RadioButton android:id="@+id/vMatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_match"/>
                    <RadioButton android:id="@+id/vNotMatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_not_match"/>
                    <RadioButton android:id="@+id/vInsufficient" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_insufficient"/>
                </RadioGroup>
                <CheckBox android:id="@+id/vReviewed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:textSize="20sp" android:fontFamily="@font/be_vietnam_pro_regular" android:saveEnabled="false" android:text="@string/v_reviewed"/>
                <ProgressBar android:id="@+id/vDecisionProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/vDecisionMessage" style="@style/Widget.GrandMa.VerificationMessage"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/vApprove" style="@style/Widget.GrandMa.VerificationPrimary" android:text="@string/v_approve"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/vNeedsInfo" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_needs_info"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/vReject" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_reject"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/vRevoke" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_revoke"/>
                <LinearLayout android:id="@+id/vReasonSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone" android:saveEnabled="false">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/vReason" android:text="@string/v_reason" android:textAppearance="@style/TextAppearance.GrandMa.Label"/>
                    <androidx.appcompat.widget.AppCompatEditText android:id="@+id/vReason" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:saveEnabled="false"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vReasonConfirm" style="@style/Widget.GrandMa.VerificationPrimary" android:text="@string/v_needs_info"/>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/vReasonCancel" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/v_cancel_reason"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        
    </LinearLayout>

    </ScrollView>
    <include layout="@layout/role_navigation"/>
</LinearLayout>
