<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttsContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_tts_pill"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="Nút nghe giọng đọc hướng dẫn">

    <ImageView
        android:id="@+id/ttsIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_tts_play"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/ttsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Nghe hướng dẫn"
        android:textColor="#1C6758"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
