<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:minHeight="56dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivTxIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="@drawable/public_job_badge"
        android:src="@drawable/ic_arrow_down_green"
        android:contentDescription="Giao dịch"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvTxTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A1C19"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Nạp tiền vào ví"/>

        <TextView
            android:id="@+id/tvTxTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#747775"
            android:textSize="13sp"
            android:text="14:30 - 27/10/2026"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTxAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2E7D32"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="+500.000 đ"/>
</LinearLayout>
