<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
    android:layout_marginBottom="4dp" android:clickable="true" android:focusable="true"
    android:screenReaderFocusable="true" android:saveEnabled="false" android:clipToOutline="true"
    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardUseCompatPadding="false"
    app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp" app:strokeColor="@color/public_card_stroke" app:rippleColor="@color/button_ripple">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
        <FrameLayout android:layout_width="match_parent" android:layout_height="176dp" android:background="@color/surface_soft_green">
            <ImageView android:id="@+id/pbCardImage" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/pbCardIllustration" style="@style/Widget.GrandMa.PublicBadge"
                android:layout_gravity="bottom|end" android:layout_margin="8dp" android:text="@string/pb_illustration"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/pbCardBadge" style="@style/Widget.GrandMa.PublicBadge" android:text="@string/pb_reviewed"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="top" android:layout_marginTop="10dp">
                <TextView android:id="@+id/pbCardTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GrandMa.PublicCardTitle" android:maxLines="3" android:ellipsize="end"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp" android:src="@drawable/ic_public_chevron" android:importantForAccessibility="no"/>
            </LinearLayout>
            <TextView android:id="@+id/pbCardEmployer" style="@style/Widget.GrandMa.PublicCardBody" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/pbCardCategory" style="@style/Widget.GrandMa.PublicCardBody"/>
            <TextView android:id="@+id/pbCardDays" style="@style/Widget.GrandMa.PublicCardBody" android:textColor="@color/brand_green"/>
            <TextView android:id="@+id/pbCardSchedule" style="@style/Widget.GrandMa.PublicCardBody" android:textColor="@color/brand_green"
                android:maxLines="2" android:ellipsize="end"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" android:background="@color/public_card_border"/>
            <TextView android:id="@+id/pbCardPay" style="@style/Widget.GrandMa.PublicCardBody" android:textAppearance="@style/TextAppearance.GrandMa.Label"/>
            <TextView android:id="@+id/pbCardDeadline" style="@style/Widget.GrandMa.PublicCardBody"/>
            <TextView android:id="@+id/pbCardCachedAt" style="@style/Widget.GrandMa.PublicCardBody" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
