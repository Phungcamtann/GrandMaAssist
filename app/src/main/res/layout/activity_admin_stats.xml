<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminStatsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_ivory">

    <include layout="@layout/role_topbar"/>

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/statsBack"
            style="@style/Widget.GrandMa.PublicToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:background="@drawable/public_back_button"
            android:gravity="start|center_vertical"
            android:textSize="18sp"
            android:text="@string/n_back"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/statsReload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_reload"
            android:tint="#1C6758"
            android:contentDescription="Tải lại thống kê" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thống kê hệ thống"
                android:textAppearance="@style/TextAppearance.GrandMa.Title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1C6758" />

            <TextView
                android:id="@+id/statsUpdatedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Đang tổng hợp số liệu..."
                android:textColor="#5C6360"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/statsProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Lưới Dashboard 2 hàng x 2 cột -->
            <!-- Hàng 1: Người thuê (Cột 1) & Người tìm việc (Cột 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Khối 1: Người thuê -->
                <LinearLayout
                    android:id="@+id/statsCardEmployers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="140dp"
                    android:padding="16dp"
                    android:background="@drawable/verification_section"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_role_hire"
                        android:tint="#1C6758"
                        android:contentDescription="Người thuê" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Người thuê"
                        android:textColor="#5C6360"
                        android:textSize="14sp"
                        android:fontFamily="@font/be_vietnam_pro_regular" />

                    <TextView
                        android:id="@+id/statsEmployersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#1A1C19"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro_semibold" />

                    <TextView
                        android:id="@+id/statsEmployersVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đã xác minh: 0"
                        android:textColor="#1C6758"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Khối 2: Người tìm việc -->
                <LinearLayout
                    android:id="@+id/statsCardSeekers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="140dp"
                    android:padding="16dp"
                    android:background="@drawable/verification_section"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_role_work"
                        android:tint="#1C6758"
                        android:contentDescription="Người tìm việc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Người tìm việc"
                        android:textColor="#5C6360"
                        android:textSize="14sp"
                        android:fontFamily="@font/be_vietnam_pro_regular" />

                    <TextView
                        android:id="@+id/statsSeekersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#1A1C19"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro_semibold" />

                    <TextView
                        android:id="@+id/statsSeekersVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đã duyệt CCCD: 0"
                        android:textColor="#1C6758"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hàng 2: Tin tuyển dụng (Cột 1) & Phí nền tảng (Cột 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Khối 3: Tin tuyển dụng -->
                <LinearLayout
                    android:id="@+id/statsCardJobs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="140dp"
                    android:padding="16dp"
                    android:background="@drawable/verification_section"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_nav_queue"
                        android:tint="#1C6758"
                        android:contentDescription="Tin tuyển dụng" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tin tuyển dụng"
                        android:textColor="#5C6360"
                        android:textSize="14sp"
                        android:fontFamily="@font/be_vietnam_pro_regular" />

                    <TextView
                        android:id="@+id/statsJobsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#1A1C19"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro_semibold" />

                    <TextView
                        android:id="@+id/statsJobsOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đang mở: 0"
                        android:textColor="#1C6758"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Khối 4: Phí dịch vụ nền tảng -->
                <LinearLayout
                    android:id="@+id/statsCardFees"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="140dp"
                    android:padding="16dp"
                    android:background="@drawable/verification_section"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wallet"
                        android:tint="#1C6758"
                        android:contentDescription="Phí dịch vụ" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Phí dịch vụ thu"
                        android:textColor="#5C6360"
                        android:textSize="14sp"
                        android:fontFamily="@font/be_vietnam_pro_regular" />

                    <TextView
                        android:id="@+id/statsPlatformFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 đ"
                        android:textColor="#B45309"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro_semibold" />

                    <TextView
                        android:id="@+id/statsCompletedSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 ca hoàn tất"
                        android:textColor="#5C6360"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Khối Bổ sung: Tổng kết Hoạt động Ca làm việc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="@drawable/verification_section"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉ số hoạt động ca làm việc"
                    android:textColor="#1A1C19"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng số ca đã tạo:"
                        android:textColor="#5C6360"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/statsTotalSessionsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#1A1C19"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ca hoàn thành thành công:"
                        android:textColor="#5C6360"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/statsCompletedSessionsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#1C6758"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tỷ lệ hoàn thành:"
                        android:textColor="#5C6360"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/statsCompletionRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#1C6758"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/role_navigation"/>
</LinearLayout>
