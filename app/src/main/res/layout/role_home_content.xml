<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roleHomeContent" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/screen_padding" android:visibility="gone" android:saveEnabled="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.GrandMa.Title"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="#1C6758"
            android:accessibilityHeading="true"
            android:saveEnabled="false"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/homeAdminReload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_reload"
            android:tint="#1C6758"
            android:contentDescription="Tải lại dữ liệu"
            android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/homeIntro" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:saveEnabled="false"/>
    <LinearLayout android:id="@+id/homeMember" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeMainFuture" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_find_jobs" android:drawableStart="@drawable/ic_nav_search"/>
        <LinearLayout
            android:id="@+id/homeAttentionFuture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/verification_section"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_nav_queue"
                android:contentDescription="Việc làm sắp tới" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeAttentionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Việc làm sắp tới"
                    android:textColor="#1A1C19"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAttentionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Chưa có việc sắp tới"
                    android:textColor="#5C6360"
                    android:textSize="15sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />
            </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeWorkFuture" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_my_jobs" android:drawableStart="@drawable/ic_role_work"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeOtherFuture" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_other_jobs" android:drawableStart="@drawable/ic_nav_search"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeOpenProfile" style="@style/Widget.GrandMa.HomeButton" android:text="@string/n_profile_open" android:drawableStart="@drawable/ic_nav_account" android:visibility="gone"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeHelpFuture" style="@style/Widget.GrandMa.HomeFuture" android:text="@string/n_help" android:drawableStart="@drawable/ic_phone_support"/>
        <TextView android:id="@+id/homeAudioGuide" style="@style/Widget.GrandMa.VerificationSecondary" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/gs_listen_guide" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/homeAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView
            android:id="@+id/homeAdminUpdatedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Số liệu thực tế của toàn hệ thống"
            android:textColor="#5C6360"
            android:textSize="14sp"
            android:fontFamily="@font/be_vietnam_pro_regular" />

        <!-- 4 Khối Thống kê Dashboard (2 Hàng x 2 Cột) -->
        <!-- Hàng 1: Người thuê & Người tìm việc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Khối 1: Người thuê -->
            <LinearLayout
                android:id="@+id/homeAdminCardEmployers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="125dp"
                android:padding="14dp"
                android:background="@drawable/verification_section"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_role_hire"
                    android:tint="#1C6758"
                    android:contentDescription="Người thuê" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Người thuê"
                    android:textColor="#5C6360"
                    android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />

                <TextView
                    android:id="@+id/homeAdminEmployersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="#1A1C19"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminEmployersVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đã xác minh: 0"
                    android:textColor="#1C6758"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Khối 2: Người tìm việc -->
            <LinearLayout
                android:id="@+id/homeAdminCardSeekers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="125dp"
                android:padding="14dp"
                android:background="@drawable/verification_section"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_role_work"
                    android:tint="#1C6758"
                    android:contentDescription="Người tìm việc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Người tìm việc"
                    android:textColor="#5C6360"
                    android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />

                <TextView
                    android:id="@+id/homeAdminSeekersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="#1A1C19"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminSeekersVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đã duyệt CCCD: 0"
                    android:textColor="#1C6758"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hàng 2: Tin tuyển dụng & Phí dịch vụ thu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Khối 3: Tin tuyển dụng -->
            <LinearLayout
                android:id="@+id/homeAdminCardJobs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="125dp"
                android:padding="14dp"
                android:background="@drawable/verification_section"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_nav_queue"
                    android:tint="#1C6758"
                    android:contentDescription="Tin tuyển dụng" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tin tuyển dụng"
                    android:textColor="#5C6360"
                    android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />

                <TextView
                    android:id="@+id/homeAdminJobsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="#1A1C19"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminJobsOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đang mở: 0"
                    android:textColor="#1C6758"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Khối 4: Phí dịch vụ thu -->
            <LinearLayout
                android:id="@+id/homeAdminCardFee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="125dp"
                android:padding="14dp"
                android:background="@drawable/verification_section"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_wallet"
                    android:tint="#1C6758"
                    android:contentDescription="Phí dịch vụ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Phí dịch vụ thu"
                    android:textColor="#5C6360"
                    android:textSize="13sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />

                <TextView
                    android:id="@+id/homeAdminFeeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 đ"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminFeeCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0 ca hoàn tất"
                    android:textColor="#1C6758"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tiêu đề phân mục: Hàng đợi cần xử lý -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="4dp"
            android:text="Hàng đợi cần xử lý"
            android:textColor="#1C6758"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro_semibold" />

        <!-- Khối 1: Tin cần duyệt -->
        <LinearLayout
            android:id="@+id/homeAdminPostsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/verification_section"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_role_work"
                android:tint="#1C6758"
                android:contentDescription="Tin cần duyệt" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeAdminPostsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tin cần duyệt"
                    android:textColor="#1A1C19"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminPostsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đang kiểm tra tin chờ duyệt..."
                    android:textColor="#5C6360"
                    android:textSize="15sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- Khối 2: Hồ sơ chờ duyệt -->
        <LinearLayout
            android:id="@+id/homeAdminProfilesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/verification_section"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_bank_card"
                android:tint="#1C6758"
                android:contentDescription="Hồ sơ chờ duyệt" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeAdminProfilesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hồ sơ chờ duyệt"
                    android:textColor="#1A1C19"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro_semibold" />

                <TextView
                    android:id="@+id/homeAdminProfilesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đang kiểm tra hồ sơ..."
                    android:textColor="#5C6360"
                    android:textSize="15sp"
                    android:fontFamily="@font/be_vietnam_pro_regular" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
