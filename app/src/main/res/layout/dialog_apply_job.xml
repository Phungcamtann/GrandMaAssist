<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialogApplyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title_apply"
            android:textAppearance="@style/TextAppearance.GrandMa.Title"
            android:textSize="22sp"
            android:textColor="@color/brand_green"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/dialogApplyJobName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.GrandMa.Label"
            android:textSize="18sp"
            android:textColor="#1A1C19" />

        <LinearLayout
            style="@style/Widget.GrandMa.ProfileSection"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Widget.GrandMa.ProfileSectionHeading"
                android:text="@string/app_applicant_info" />

            <TextView
                android:id="@+id/dialogApplyApplicantName"
                style="@style/Widget.GrandMa.PublicCardBody"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="#1A1C19" />

            <TextView
                android:id="@+id/dialogApplyApplicantPhone"
                style="@style/Widget.GrandMa.PublicCardBody"
                android:textSize="15sp"
                android:textColor="#424940" />

            <TextView
                android:id="@+id/dialogApplyApplicantSkills"
                style="@style/Widget.GrandMa.PublicCardBody"
                android:textSize="15sp"
                android:textColor="@color/brand_green" />
        </LinearLayout>

        <TextView
            style="@style/Widget.GrandMa.DraftLabel"
            android:layout_marginTop="16dp"
            android:text="@string/app_message_label"
            android:labelFor="@id/dialogApplyMessage" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/dialogApplyMessage"
            style="@style/Widget.GrandMa.ProfileInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLength="500"
            android:inputType="textCapSentences|textMultiLine"
            android:hint="@string/app_message_hint" />

        <CheckBox
            android:id="@+id/dialogApplyConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="@string/app_share_phone_consent"
            android:textColor="#1A1C19"
            android:textSize="15sp"
            android:fontFamily="@font/be_vietnam_pro_regular" />

        <TextView
            android:id="@+id/dialogApplyError"
            style="@style/Widget.GrandMa.DraftError"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/dialogApplyProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dialogApplyBtnCancel"
                style="@style/Widget.GrandMa.VerificationSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="@string/n_back"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dialogApplyBtnSubmit"
                style="@style/Widget.GrandMa.VerificationPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="@string/app_confirm_apply"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
