<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/brand_logo_surface"
    android:padding="20dp">

    <!-- State 1: Scanning QR -->
    <LinearLayout
        android:id="@+id/layoutQrScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C6758"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Quét mã QR để nạp tiền"/>

        <TextView
            android:id="@+id/tvQrAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#2E7D32"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="330.000 đ"/>

        <!-- QR Code Container -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/account_card">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/ic_qr_code"
                android:contentDescription="Mã QR thanh toán"/>
        </FrameLayout>

        <!-- Simulated Transfer Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#1A1C19"
            android:textSize="14sp"
            android:text="Vietcombank • STK: 9999 8888 6666\nChủ TK: GRANDMA ASSIST"/>

        <!-- Countdown / Auto-detect indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvQrStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#747775"
                android:textSize="14sp"
                android:text="Đang tự động xác nhận chuyển khoản..."/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQrConfirmManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="50dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/button_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="Đã chuyển tiền xong"/>
    </LinearLayout>

    <!-- State 2: Success -->
    <LinearLayout
        android:id="@+id/layoutQrSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_check_circle_green"
            android:contentDescription="Thành công"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#1C6758"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="Nạp tiền thành công!"/>

        <TextView
            android:id="@+id/tvQrSuccessAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="+330.000 đ"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#747775"
            android:textSize="14sp"
            android:text="Số tiền đã được cộng trực tiếp vào ví của bạn."/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQrDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="50dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/button_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="Hoàn tất"/>
    </LinearLayout>
</FrameLayout>
