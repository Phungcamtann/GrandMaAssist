<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F5">
    <include layout="@layout/role_topbar" />
    <ScrollView
        android:id="@+id/gsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:saveEnabled="false">
        <LinearLayout
            android:id="@+id/gsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:saveEnabled="false">
            <!-- Progress Step Indicator Header -->
            <LinearLayout
                android:id="@+id/gsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/gsStepText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gs_step_1"
                    android:textColor="#1C6758"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/gsStepBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/gsSeg1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="#1C6758" />
                    <View
                        android:id="@+id/gsSeg2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="#D0D5D2" />
                    <View
                        android:id="@+id/gsSeg3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="#D0D5D2" />
                    <View
                        android:id="@+id/gsSeg4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#D0D5D2" />
                </LinearLayout>
                <TextView
                    android:id="@+id/gsQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/gs_q_category"
                    android:textColor="#1A1C19"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/gsSubQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gs_sub_category"
                    android:textColor="#5C6360"
                    android:textSize="16sp" />
                <include
                    android:id="@+id/gsTtsController"
                    layout="@layout/layout_tts_controller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            <!-- Dynamic step contents container -->
            <LinearLayout
                android:id="@+id/gsStepContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <!-- Footer fixed area -->
    <LinearLayout
        android:id="@+id/gsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#F7F7F5">
        <LinearLayout
            android:id="@+id/gsActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/gsBtnBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/gs_action_back"
                android:textColor="#2C3332"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/gsBtnSkip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/gs_action_skip"
                android:textColor="#2C3332"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/gsBtnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Hủy tìm"
                android:textColor="#D32F2F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/gsBtnNext"
            style="@style/Widget.GrandMa.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_primary"
            android:text="@string/gs_action_continue"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />
    </LinearLayout>
    <include layout="@layout/role_navigation" />
</LinearLayout>
