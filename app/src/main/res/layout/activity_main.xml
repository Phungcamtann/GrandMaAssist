<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface_ivory">
    <include layout="@layout/role_topbar"/>
    <ScrollView android:id="@+id/main" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/screen_padding">

        <LinearLayout
            android:id="@+id/authContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <LinearLayout
                android:id="@+id/loginContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginBottom="@dimen/space_medium"
                    android:clipToOutline="true"
                    app:cardCornerRadius="@dimen/button_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_ivory"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/grandma_banner"
                        android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingEnd="@dimen/screen_padding"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_medium" android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/tabPhone" style="@style/Widget.GrandMa.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/button_method" android:text="@string/phone_method" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/tabGoogle" style="@style/Widget.GrandMa.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_small"
                            android:background="@drawable/button_method" android:text="@string/phone_method_google" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/googleContent"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.GrandMa.Title"
                        android:text="@string/auth_welcome" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_small"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body"
                        android:text="@string/auth_intro" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGoogle"
                        style="@style/Widget.GrandMa.Button.Google"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_action_gap"
                        android:drawablePadding="@dimen/google_icon_gap"
                        android:text="@string/auth_continue_google" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include layout="@layout/role_home_content"/>
            <include layout="@layout/role_account_content"/>
            <include layout="@layout/profile_content"/>
            <LinearLayout
                android:id="@+id/accountContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.GrandMa.Title"
                    android:text="@string/auth_account_title" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReturnProfile"
                    style="@style/Widget.GrandMa.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/p_return" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_large"
                    android:padding="@dimen/space_large"
                    android:background="@drawable/account_card"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/accountName"
                        android:textAppearance="@style/TextAppearance.GrandMa.Label"
                        android:text="@string/auth_name_label" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accountName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_large"
                        android:labelFor="@id/accountEmail"
                        android:textAppearance="@style/TextAppearance.GrandMa.Label"
                        android:text="@string/auth_email_label" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accountEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false"
                        android:breakStrategy="simple"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accountPhoneLabel"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_large" android:labelFor="@id/accountPhone"
                        android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/phone_number_label" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accountPhone"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:saveEnabled="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_large"
                        android:labelFor="@id/accountProvider"
                        android:textAppearance="@style/TextAppearance.GrandMa.Label"
                        android:text="@string/auth_provider_label" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accountProvider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSignOut"
                    android:minHeight="54dp"
                    android:background="@drawable/button_sign_out"
                    android:gravity="center"
                    android:textColor="#E53935"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_large"
                    android:text="@string/auth_sign_out" />
            </LinearLayout>

            <LinearLayout android:id="@+id/methodsContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
                android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_large" android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.GrandMa.Title" android:text="@string/c03_methods" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/methodsSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccountPhone"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_add_phone" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccountGoogle"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_link_google" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/methodsInstructions"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false"
                    android:layout_marginTop="@dimen/space_medium"
                    android:textAppearance="@style/TextAppearance.GrandMa.Body" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnReauthGoogle"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_reauth_google" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnReauthPhone"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_reauth_phone" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMethodsGoogle"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_choose_google" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnConfirmGoogle"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_confirm_google" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRefreshMethods"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_read_again" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCancelMethods"
                    style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small"
                    android:text="@string/c03_cancel" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/methodsStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false"
                    android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.GrandMa.Body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneForms"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
                android:orientation="vertical">
                    <include android:id="@+id/phoneEntry" layout="@layout/phone_entry" />
                    <include android:id="@+id/phoneReview" layout="@layout/phone_review" android:visibility="gone" />
                    <include android:id="@+id/phoneCode" layout="@layout/phone_code" android:visibility="gone" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/phoneStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_medium" android:saveEnabled="false"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.GrandMa.Body" android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBrowseJobs" style="@style/Widget.GrandMa.Button.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding" android:text="@string/pb_guest" android:visibility="gone"/>
            <ProgressBar
                android:id="@+id/authProgress"
                android:layout_width="@dimen/progress_size"
                android:layout_height="@dimen/progress_size"
                android:layout_marginTop="@dimen/space_large"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/brand_green"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/authStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:accessibilityLiveRegion="polite"
                android:saveEnabled="false"
                android:textAppearance="@style/TextAppearance.GrandMa.Body"
                android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                style="@style/Widget.GrandMa.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
    <include layout="@layout/role_navigation"/>
</LinearLayout>
