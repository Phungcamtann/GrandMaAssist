<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/profileContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
<com.google.android.material.textview.MaterialTextView android:id="@+id/profileMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_loading"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileReload" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_reload" />
<LinearLayout android:id="@+id/rolePicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:text="@string/p_role_title"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_role_intro"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRoleSeeker" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_seeker_card" android:drawableTop="@drawable/ic_role_work" android:drawablePadding="12dp" android:background="@drawable/role_card" android:textColor="@color/role_text" android:minHeight="168dp" android:gravity="start|center_vertical"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRoleEmployer" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_employer_card" android:drawableTop="@drawable/ic_role_hire" android:drawablePadding="12dp" android:background="@drawable/role_card" android:textColor="@color/role_text" android:minHeight="168dp" android:gravity="start|center_vertical"/>
<com.google.android.material.textview.MaterialTextView android:id="@+id/roleSelection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_selected"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRoleContinue" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_continue" />
</LinearLayout>
<LinearLayout android:id="@+id/profileEditor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:text="@string/p_title"/>
<com.google.android.material.textview.MaterialTextView android:id="@+id/profileRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_title"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/profileDisplayName" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/p_name"/>
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/profileDisplayName" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLength="100"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_area"/>
<Spinner android:id="@+id/profileArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:saveEnabled="false" android:spinnerMode="dialog" android:prompt="@string/p_area"/>
<com.google.android.material.textview.MaterialTextView android:id="@+id/profileAreaMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_areas_empty"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAreasReload" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_areas_retry" />
<LinearLayout android:id="@+id/seekerFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/profileSkills" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/p_skills"/>
<androidx.appcompat.widget.AppCompatEditText android:hint="@string/p_skills_hint" android:id="@+id/profileSkills" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/profileExperience" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/p_experience"/>
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/profileExperience" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_shifts"/>
<CheckBox android:id="@+id/profile_morning" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:saveEnabled="false" android:textSize="20sp" android:textColor="@color/text_charcoal" android:text="@string/p_morning"/>
<CheckBox android:id="@+id/profile_afternoon" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:saveEnabled="false" android:textSize="20sp" android:textColor="@color/text_charcoal" android:text="@string/p_afternoon"/>
<CheckBox android:id="@+id/profile_evening" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:saveEnabled="false" android:textSize="20sp" android:textColor="@color/text_charcoal" android:text="@string/p_evening"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_identity_note"/>
</LinearLayout>
<LinearLayout android:id="@+id/employerFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_employer_type"/>
<RadioGroup android:id="@+id/profileEmployerType" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false">
<RadioButton android:id="@+id/profile_individual" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="20sp" android:saveEnabled="false" android:textColor="@color/text_charcoal" android:text="@string/p_individual"/>
<RadioButton android:id="@+id/profile_organization" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="20sp" android:saveEnabled="false" android:textColor="@color/text_charcoal" android:text="@string/p_organization"/>
</RadioGroup>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:id="@+id/profileOrganizationLabel" android:labelFor="@id/profileOrganization" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/p_org_name"/>
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/profileOrganization" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLength="150"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/profileIntroduction" android:textAppearance="@style/TextAppearance.GrandMa.Label" android:text="@string/p_introduction"/>
<androidx.appcompat.widget.AppCompatEditText android:id="@+id/profileIntroduction" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_employer_note"/>
</LinearLayout>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:text="@string/p_contact_title"/>
<com.google.android.material.textview.MaterialTextView android:id="@+id/profileContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_no_phone"/>
<com.google.android.material.textview.MaterialTextView android:id="@+id/profileContactState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_phone_pending"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfilePhone" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/c03_add_phone" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileSync" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_sync" />
<com.google.android.material.textview.MaterialTextView android:visibility="gone" android:id="@+id/profileCompleteness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_incomplete"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileSave" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_save" />
</LinearLayout>
<LinearLayout android:id="@+id/adminProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:text="@string/p_admin"/>
<com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:saveEnabled="false" android:accessibilityHeading="false" android:textAppearance="@style/TextAppearance.GrandMa.Body" android:text="@string/p_admin_note"/>
</LinearLayout>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileAccount" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/p_account" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnProfileSignOut" style="@style/Widget.GrandMa.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/auth_sign_out" />
</LinearLayout>




