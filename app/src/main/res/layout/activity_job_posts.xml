<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jpRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface_ivory">
    <include layout="@layout/role_topbar"/>
    <LinearLayout android:id="@+id/jpToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpBack" style="@style/Widget.GrandMa.PublicToolbarButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp"
            android:background="@drawable/public_back_button" android:gravity="start|center_vertical"
            android:textSize="18sp" android:text="@string/n_back"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpReload" style="@style/Widget.GrandMa.PublicToolbarButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:textSize="15sp" android:maxLines="1" android:singleLine="true"
            android:text="@string/p_reload" android:contentDescription="@string/p_reload"/>
    </LinearLayout>
    <ScrollView android:id="@+id/jpScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:saveEnabled="false">
        <LinearLayout android:id="@+id/jpContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:saveEnabled="false">
            <TextView android:id="@+id/jpTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrandMa.Title" android:textSize="26sp"
                android:text="Tin của tôi" android:accessibilityHeading="true"/>
            <LinearLayout android:id="@+id/jpEmployerActions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp" android:layout_marginBottom="4dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpCreate"
                    style="@style/Widget.GrandMa.VerificationPrimary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="0dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:includeFontPadding="false" android:gravity="center"
                    android:textSize="16sp" android:text="@string/jd_create"/>
                <LinearLayout
                    android:id="@+id/jpFilterTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/jpTabActive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_primary"
                        android:textColor="@color/white"
                        android:text="Đang đăng"
                        android:layout_marginEnd="4dp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/jpTabCompleted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_secondary"
                        android:textColor="@color/brand_green"
                        android:text="Đã xong"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/jpTabDrafts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_secondary"
                        android:textColor="@color/brand_green"
                        android:text="Bản nháp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <View android:id="@+id/jpDrafts" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/jpAdminFilterTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/jpAdminTabPending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_primary"
                    android:textColor="@color/white"
                    android:text="Chưa duyệt"
                    android:layout_marginEnd="4dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/jpAdminTabApproved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/brand_green"
                    android:text="Đã duyệt"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/jpBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/jpReasonSection" style="@style/Widget.GrandMa.ProfileSection" android:visibility="gone">
                <TextView android:id="@+id/jpReasonTitle" style="@style/Widget.GrandMa.DraftLabel" android:text="Lý do từ chối" android:labelFor="@id/jpReason"/>
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/jpReason" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpConfirmAction" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Xác nhận"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpCancelReject" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Hủy"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/jpProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="16dp" android:visibility="gone" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/jpMessage" style="@style/Widget.GrandMa.VerificationMessage" android:accessibilityLiveRegion="polite"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpApprove" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Chấp thuận" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpReject" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Từ chối" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpHide" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Ẩn tin tuyển dụng" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpViewSession" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Xem thỏa thuận ca" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpViewApplicants" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Xem danh sách ứng viên" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpEdit" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Sửa tin tuyển dụng" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpClose" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Đóng tin (Ngừng nhận đơn)" android:textColor="@color/text_error" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpMore" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Tải thêm" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/role_navigation"/>
</LinearLayout>
