<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/jpRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_ivory">
    <include layout="@layout/role_topbar"/>
    <ScrollView android:id="@+id/jpScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:saveEnabled="false">
        <LinearLayout android:id="@+id/jpContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:saveEnabled="false">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpBack" style="@style/Widget.GrandMa.BackLink" android:text="@string/n_back"/>
            <TextView android:id="@+id/jpTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.GrandMa.Title" android:accessibilityHeading="true"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpDrafts" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Nháp trên máy"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpProfiles" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Kiểm tra hồ sơ" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpReload" style="@style/Widget.GrandMa.VerificationSecondary" android:text="@string/p_reload"/>
            <LinearLayout android:id="@+id/jpBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/jpReasonSection" style="@style/Widget.GrandMa.ProfileSection" android:visibility="gone">
                <TextView style="@style/Widget.GrandMa.DraftLabel" android:text="Lý do từ chối" android:labelFor="@id/jpReason"/>
                <androidx.appcompat.widget.AppCompatEditText android:id="@+id/jpReason" style="@style/Widget.GrandMa.ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpConfirmReject" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Xác nhận từ chối"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpCancelReject" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Hủy"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/jpProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="16dp" android:visibility="gone" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/jpMessage" style="@style/Widget.GrandMa.VerificationMessage" android:accessibilityLiveRegion="polite"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpApprove" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Chấp thuận" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpReject" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Từ chối" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpEdit" style="@style/Widget.GrandMa.VerificationPrimary" android:text="Sửa và gửi lại" android:visibility="gone"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/jpMore" style="@style/Widget.GrandMa.VerificationSecondary" android:text="Tải thêm" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/role_navigation"/>
</LinearLayout>
