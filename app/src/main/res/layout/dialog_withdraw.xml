<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/brand_logo_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1C6758"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="Rút tiền về tài khoản"/>

    <!-- Destination bank info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/account_card">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_bank_card"
            android:contentDescription="Tài khoản nhận"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWithdrawBankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A1C19"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="MBBank - **** 1234"/>

            <TextView
                android:id="@+id/tvWithdrawAccountHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#747775"
                android:textSize="13sp"
                android:text="NGUYEN VAN A"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWithdrawAvailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#1C6758"
        android:textSize="14sp"
        android:text="Số dư khả dụng: 500.000 đ"/>

    <!-- Amount input with Withdraw All button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etWithdrawAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:padding="12dp"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:textColor="#1A1C19"
            android:textSize="18sp"
            android:textStyle="bold"
            android:hint="Nhập số tiền rút"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWithdrawAll"
            style="@style/Widget.GrandMa.BackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:includeFontPadding="false"
            android:textColor="#1C6758"
            android:text="Rút hết"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmWithdraw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="52dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/button_primary"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:text="Xác nhận rút tiền"/>
</LinearLayout>
