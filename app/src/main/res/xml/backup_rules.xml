<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="database" path="public_jobs.db"/>
    <exclude domain="database" path="public_jobs.db-journal"/>
    <exclude domain="database" path="public_jobs.db-wal"/>
    <exclude domain="database" path="public_jobs.db-shm"/>
    <exclude domain="database" path="job_drafts.db"/>
    <exclude domain="database" path="job_drafts.db-journal"/>
    <exclude domain="database" path="job_drafts.db-wal"/>
    <exclude domain="database" path="job_drafts.db-shm"/>
    <exclude domain="database" path="search_preferences.db"/>
    <exclude domain="database" path="search_preferences.db-journal"/>
    <exclude domain="database" path="search_preferences.db-wal"/>
    <exclude domain="database" path="search_preferences.db-shm"/>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
