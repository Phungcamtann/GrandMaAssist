<resources>
    <style name="Widget.GrandMa.ProfileInput" parent="Widget.AppCompat.EditText">
        <item name="android:textAppearance">@style/TextAppearance.GrandMa.Body</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textColor">@color/text_charcoal</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:gravity">start|top</item>
    </style>
</resources>
