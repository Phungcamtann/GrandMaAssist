<resources>
    <style name="Widget.GrandMa.DraftLabel" parent="Widget.GrandMa.VerificationHeading">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/text_charcoal</item>
        <item name="android:accessibilityHeading">false</item>
    </style>
    <style name="Widget.GrandMa.DraftCheck" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item><item name="android:saveEnabled">false</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>
    <style name="Widget.GrandMa.DraftRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item><item name="android:saveEnabled">false</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>
    <style name="Widget.GrandMa.DraftSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item><item name="android:spinnerMode">dialog</item><item name="android:saveEnabled">false</item>
    </style>
    <style name="Widget.GrandMa.DraftError" parent="Widget.GrandMa.VerificationMessage">
        <item name="android:textColor">@color/text_error</item><item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
