<resources>
    <style name="Widget.GrandMa.Input" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_charcoal</item>
        <item name="android:textColorHint">@color/button_disabled_text</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="TextAppearance.GrandMa.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="lineHeight">@dimen/line_body</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>
    <style name="TextAppearance.GrandMa.Title" parent="TextAppearance.GrandMa.Body">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <!-- Set the actual variable axis and requested weight at the TextView too.
             A font-family filename alone does not override an inherited normal style. -->
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="lineHeight">@dimen/line_title</item>
        <item name="android:textColor">@color/text_charcoal</item>
    </style>
    <style name="TextAppearance.GrandMa.Label" parent="TextAppearance.GrandMa.Body">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
    </style>
    <style name="Widget.GrandMa.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/space_medium</item>
        <item name="android:paddingBottom">@dimen/space_medium</item>
        <item name="android:paddingStart">@dimen/space_medium</item>
        <item name="android:paddingEnd">@dimen/space_medium</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="Widget.GrandMa.Button.Secondary" parent="Widget.GrandMa.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.GrandMa.Button.Google" parent="Widget.GrandMa.Button">
        <item name="android:background">@drawable/button_google</item>
        <item name="android:textColor">@color/google_button_text</item>
        <item name="android:fontFamily">@font/google_sans_medium</item>
        <item name="fontFamily">@font/google_sans_medium</item>
        <item name="android:paddingStart">@dimen/google_button_padding</item>
        <item name="android:paddingEnd">@dimen/google_button_padding</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
