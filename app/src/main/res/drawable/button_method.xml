<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/button_ripple">
    <item><selector>
        <item android:state_selected="true"><shape>
            <solid android:color="@color/surface_soft_green" />
            <stroke android:width="2dp" android:color="@color/brand_green" />
            <corners android:radius="@dimen/button_corner" />
        </shape></item>
        <item><shape>
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/google_button_border" />
            <corners android:radius="@dimen/button_corner" />
        </shape></item>
    </selector></item>
</ripple>
