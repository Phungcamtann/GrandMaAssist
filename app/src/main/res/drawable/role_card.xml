<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/button_ripple">
    <item><selector>
        <item android:state_selected="true"><shape>
            <gradient android:startColor="@color/brand_gradient_start" android:endColor="@color/brand_gradient_end" android:angle="0"/>
            <corners android:radius="16dp"/>
        </shape></item>
        <item><shape><solid android:color="@color/white"/><stroke android:width="1dp" android:color="@color/brand_green"/><corners android:radius="16dp"/></shape></item>
    </selector></item>
</ripple>